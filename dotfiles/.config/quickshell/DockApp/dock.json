/*
Default configuration file for the Quickshell Dock.

This file documents the built-in defaults (kept in sync with defaultSettings in
DockWindow.qml). The dock actually reads, in this order:

  1. ~/.config/ml4w-dock/dock.json        — user override, master when present
  2. ~/.config/ml4w/settings/dock.json    — shipped fallback, holds the dynamic
                                            state (enabled / autohide / pinned)

The master file is merged over the built-in defaults, so a partial file still
leaves every value defined.
*/
{
    "dock": {
        "enabled": true,
        "autohide": false,
        "iconSize": 32,
        "spacing": 8,
        "marginBottom": 10,
        "reserveSpace": true,
        "hideDelay": 400
    },
    "pill": {
        "radius": 16,
        "padding": 12,
        "animationDuration": 350
    },
    "border": {
        "width": 2,
        "colorTop": "",
        "colorBottom": ""
    },
    "opacity": {
        "normal": 0.7
    },
    "apps": {
        "pinned": [
            "firefox",
            "kitty",
            "org.gnome.Nautilus",
            "org.gnome.Calculator"
        ]
    }
}
